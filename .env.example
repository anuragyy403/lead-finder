# Copy this file to .env and fill in the values. Never commit .env.

# Google Cloud API key, restricted to Places API (New) + PageSpeed Insights API
GOOGLE_API_KEY=

# The long ID in your Google Sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# Service account key for Google Sheets. Use ONE of these:
#   a path to the downloaded JSON file (local runs)
GOOGLE_SERVICE_ACCOUNT_FILE=.secrets/service-account.json
#   or the whole JSON content on one line (GitHub Actions secret)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Hard stop on Places API calls per run (each search page = 1 call, max 3 pages per target)
MAX_REQUESTS_PER_RUN=30

# Optional: shown in the User-Agent when the script visits business websites
CONTACT_EMAIL=
